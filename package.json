{
  "name": "@tscircuit/bga-fanout-solver",
  "version": "0.0.1",
  "description": "Incremental fixed-target BGA breakout fanout solver for SimpleRouteJson",
  "private": true,
  "type": "module",
  "module": "lib/index.ts",
  "files": ["lib"],
  "exports": {
    ".": {
      "import": "./lib/index.ts",
      "types": "./lib/index.ts"
    }
  },
  "scripts": {
    "start": "cosmos",
    "build": "bunx tsc --noEmit",
    "build:site": "cosmos-export",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@tscircuit/core": "0.0.1736",
    "@tscircuit/solver-utils": "0.0.19",
    "graphics-debug": "0.0.99"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "bun-match-svg": "0.0.16",
    "react": "19.2.8",
    "react-cosmos": "7.3.0",
    "react-cosmos-plugin-vite": "7.3.0",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
